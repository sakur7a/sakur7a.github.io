---
interface Props {
  name: 'github' | 'home' | 'blog' | 'email' | 'sun' | 'moon' | 'menu';
  class?: string;
}
const { name, class: className } = Astro.props;
---

<svg class={className} width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {name === 'github' && <path d="M9 19c-4.3 1.3-4.3-2.2-6-2.7m12 6v-3.5a3 3 0 0 0-.8-2.3c2.7-.3 5.5-1.3 5.5-6A4.7 4.7 0 0 0 18.4 7a4.3 4.3 0 0 0-.1-3.4s-1-.3-3.6 1.3a12.1 12.1 0 0 0-6.5 0C5.6 3.3 4.6 3.6 4.6 3.6A4.3 4.3 0 0 0 4.5 7a4.7 4.7 0 0 0-1.3 3.5c0 4.7 2.8 5.7 5.5 6A3 3 0 0 0 8 18.8V22" />}
  {name === 'home' && <><path d="m3 10 9-7 9 7v10a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1Z" /><path d="M9 21v-8h6v8" /></>}
  {name === 'blog' && <><path d="M4 4h5a4 4 0 0 1 4 4v13a4 4 0 0 0-4-3H4Z" /><path d="M13 8a4 4 0 0 1 4-4h4v14h-4a4 4 0 0 0-4 3" /></>}
  {name === 'email' && <><rect x="3" y="5" width="18" height="14" rx="2" /><path d="m3 7 9 6 9-6" /></>}
  {name === 'sun' && <><circle cx="12" cy="12" r="4" /><path d="M12 2v2m0 16v2M2 12h2m16 0h2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></>}
  {name === 'moon' && <path d="M20.9 13a9 9 0 1 1-9.9-9.9A7 7 0 0 0 20.9 13Z" />}
  {name === 'menu' && <path d="M4 6h16M4 12h16M4 18h16" />}
</svg>
