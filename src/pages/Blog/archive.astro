---
import BlogLayout from '../../layouts/BlogLayout.astro';
import { blog, getPosts, dateLabel, isoDate } from '../../lib/blog';
const posts = await getPosts();
const groups = blog.categories.map(category => ({ ...category, posts: posts.filter(post => post.data.categories.includes(category.name)) }));
---
<BlogLayout title="Archive" image="/Blog/assets/images/site/wallhaven-6l21lx-1778342041220.png">
  <article class="hentry"><div class="entry-content"><h1 class="post-title">Archive</h1>
    <nav class="archive-tabs" aria-label="文章分类">{groups.map(group => <a href={`#${group.slug}`}><span>{group.name}</span><em>{group.posts.length}</em></a>)}</nav>
    <div class="archive-groups">{groups.map(group => <section class="archive-group" id={group.slug} aria-labelledby={`${group.slug}-title`}><header class="archive-group-header"><div><h2 id={`${group.slug}-title`}>{group.name}</h2><p>{group.description}</p></div><span>{group.posts.length} 篇</span></header>{group.posts.length ? <div class="archive-list" aria-label={`${group.name}文章`}>{group.posts.map(post => <a class="archive-row" href={post.data.permalink}><time datetime={isoDate(post.data.date)}>{dateLabel(post.data.date)}</time><span><strong>{post.data.title}</strong>{post.data.summary && <small>{post.data.summary}</small>}</span></a>)}</div> : <p class="archive-empty">这一类还在等第一篇文章。</p>}</section>)}</div>
  </div></article>
</BlogLayout>
