---
import BlogLayout from '../../features/blog/BlogLayout.astro';
import PostDate from '../../features/blog/components/PostDate.astro';
import { getArchiveGroups, getPosts } from '../../features/blog/content';

const posts = await getPosts();
const groups = getArchiveGroups(posts);
---

<BlogLayout title="归档">
  <header class="article-heading archive-heading">
    <h1>文章归档</h1>
    <p>{posts.length} 篇文章</p>
  </header>
  {groups.length ? (
    <nav class="archive-nav" aria-label="文章分类">
      {groups.map(({ slug, name, posts }) => <a href={`#${slug}`}>{name} <span>{posts.length} 篇</span></a>)}
    </nav>
  ) : <p class="empty-state">暂时还没有文章。</p>}
  {groups.map(({ slug, name, posts }) => (
    <section class="archive-group" id={slug} aria-labelledby={`${slug}-title`}>
      <h2 id={`${slug}-title`}>{name}</h2>
      <ul class="archive-list">
        {posts.map(({ data }) => (
          <li><PostDate date={data.date} /><a href={data.permalink}>{data.title}</a></li>
        ))}
      </ul>
    </section>
  ))}
</BlogLayout>
