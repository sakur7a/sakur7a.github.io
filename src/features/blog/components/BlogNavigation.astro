---
import { BLOG_ROOT, blogPaths } from '../../../config/site.js';
import { blog } from '../config';

interface Props {
  homeActive: boolean;
}

const { homeActive } = Astro.props;
---

<div class="header-menu" id="J_header">
  <ul class="header-item-container">
    <li class:list={['header-item-title', { active: homeActive }]}>
      <a href={BLOG_ROOT} class="title">{blog.title}</a>
    </li>
    {blog.navigation.map(({ label, href, external }) => (
      <li class:list={['header-item-left', { active: Astro.url.pathname === href }]}>
        <a href={href} target={external ? '_blank' : undefined} rel={external ? 'noopener noreferrer' : undefined}>{label}</a>
      </li>
    ))}
    <li class="header-item search-btn-container">
      <button id="search-btn" class="search-btn" data-search-url={blogPaths.search} aria-label="搜索文章" title="搜索文章 (Press /)">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
          <circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="2" />
          <path d="M20 20L16 16" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
        </svg>
      </button>
    </li>
    <li class="header-item theme-toggle-container">
      <button id="J_theme_toggle" class="theme-toggle-btn" aria-label="切换深色模式" title="切换深色模式">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" id="J_theme_icon">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </button>
    </li>
  </ul>
</div>
