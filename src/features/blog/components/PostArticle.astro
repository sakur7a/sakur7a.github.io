---
import type { CollectionEntry } from 'astro:content';
import PostDate from './PostDate.astro';

interface Props {
  post: CollectionEntry<'posts'>['data'];
}

const { post } = Astro.props;
const coverStyle = post.cover && `background-image: url('${post.cover}'); background-position: ${post.cover_position || '50% 50%'};`;
---

<div class="post-shell">
  <article class="hentry">
    <div class="entry-content" id="post-content">
      <h1 class="post-title entry-title">{post.title}</h1>
      {post.cover && <div class="post-cover" style={coverStyle}></div>}
      <div class="page-info">
        <span>{post.categories.join(' / ')}</span>
        <PostDate date={post.date} />
      </div>
      <slot />
    </div>
  </article>
  <aside class="post-toc" aria-labelledby="post-toc-title" hidden>
    <div class="post-toc-inner">
      <h2 id="post-toc-title">文章目录</h2>
      <nav id="post-toc-nav" aria-label="文章目录"></nav>
    </div>
  </aside>
</div>
