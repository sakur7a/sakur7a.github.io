---
import { dateLabel, isoDate, type SiteDate } from '../../../shared/dates';

interface Props {
  date: SiteDate;
  bracketed?: boolean;
}

const { date, bracketed = false } = Astro.props;
const label = dateLabel(date);
---
<time class="date-text" datetime={isoDate(date)}>{bracketed ? `【${label}】` : label}</time>
