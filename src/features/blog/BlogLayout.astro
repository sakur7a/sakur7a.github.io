---
import { BLOG_PREFIX, BLOG_ROOT, SITE_ORIGIN, blogPaths } from '../../config/site.js';
import SiteDocument from '../../shared/SiteDocument.astro';
import { isoDate, type SiteDate } from '../../shared/dates';
import { blog } from './config';
import BlogNavigation from './components/BlogNavigation.astro';
import SearchPanel from './components/SearchPanel.astro';
import './styles/index.css';
import '../../shared/dates.css';

interface Props {
  title?: string;
  summary?: string;
  image?: string;
  position?: string;
  bodyId?: 'page' | 'post' | 'post-index';
  homeActive?: boolean;
  date?: SiteDate;
}

const {
  title = blog.description,
  summary = blog.description,
  image,
  position = '50% 50%',
  bodyId = 'page',
  homeActive = false,
  date,
} = Astro.props;
const pageTitle = title === blog.description ? blog.title : `${title} | ${blog.title}`;
const canonicalPath = Astro.url.pathname === BLOG_PREFIX ? BLOG_ROOT : Astro.url.pathname;
const heroStyle = image && `background-image: url('${image}'); background-position: ${position};`;
---

<SiteDocument lang="zh-CN" title={pageTitle} description={summary} canonicalPath={canonicalPath} bodyId={bodyId}>
  <Fragment slot="metadata">
    <meta property="og:title" content={title} />
    <meta property="og:description" content={summary} />
    <meta property="og:url" content={new URL(canonicalPath, SITE_ORIGIN).href} />
    <meta property="og:type" content={date ? 'article' : 'website'} />
    {image && <meta property="og:image" content={new URL(image, SITE_ORIGIN).href} />}
    {date && <meta property="article:published_time" content={isoDate(date)} />}
    <link rel="alternate" type="application/atom+xml" title={blog.title} href={blogPaths.feed} />
  </Fragment>

  <BlogNavigation homeActive={homeActive} />
  <div class:list={['entry-header', { 'has-image': image }]} style={heroStyle}>
    <p class="header-title">{title}</p>
    <canvas id="J_firework_canvas" aria-hidden="true"></canvas>
  </div>
  <main id="main" role="main"><slot /></main>
  <SearchPanel />
  <footer class="site-footer">
    <p>© <span class="date-text">{new Date().getFullYear()}</span> {blog.title}. Something for nothing.</p>
  </footer>

  <script>
    import { mountBlog } from './client/index.js';
    mountBlog();
  </script>
</SiteDocument>
