---
import SiteDocument from '../../shared/SiteDocument.astro';
import HomepageHeader from './components/HomepageHeader.astro';
import { site } from './profile';
import './styles/index.css';
import '../../shared/dates.css';

interface Props {
  title?: string;
  description?: string;
}

const { title = site.title, description = site.description } = Astro.props;
---

<SiteDocument lang="en" title={title} description={description}>
  <Fragment slot="metadata">
    <meta name="author" content={site.title} />
    <link rel="icon" href="/assets/img/style.png" type="image/png" />
    <link rel="stylesheet" href="/assets/css/jinkai.css" />
    <link rel="preload" href="/assets/fonts/outfit/outfit-latin-500.woff2" as="font" type="font/woff2" crossorigin />
  </Fragment>

  <a class="skip-link" href="#main-content">Skip to content</a>
  <HomepageHeader />
  <div class="wrapper">
    <slot name="sidebar" />
    <main class="content" id="main-content" tabindex="-1">
      <slot />
    </main>
  </div>

  <script>
    import { mountHomepage } from './client';
    mountHomepage();
  </script>
</SiteDocument>
