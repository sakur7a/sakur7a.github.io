---
import { SITE_ORIGIN } from '../config/site.js';

interface Props {
  lang: 'en' | 'zh-CN';
  title: string;
  description: string;
  canonicalPath?: string;
  defaultTheme?: 'light' | 'dark';
}

const {
  lang,
  title,
  description,
  canonicalPath = Astro.url.pathname,
  defaultTheme,
} = Astro.props;
---

<!doctype html>
<html lang={lang} data-theme={defaultTheme}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(canonicalPath, SITE_ORIGIN).href} />
    <slot name="metadata" />
    <script is:inline src="/assets/js/theme.js"></script>
  </head>
  <body>
    <slot />
  </body>
</html>
