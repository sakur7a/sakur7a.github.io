---
import { blog } from '../lib/blog';
const { title = blog.description, summary = blog.description, image, position = '50% 50%', bodyId = 'page', homeActive = false, date } = Astro.props;
const canonical = new URL(Astro.url.pathname === '/Blog' ? '/Blog/' : Astro.url.pathname, blog.site).href;
const menu = [['Archive', '/Blog/archive.html'], ['Moments', '/Blog/moments.html'], ['About', '/Blog/about.html'], ['GitHub', 'https://github.com/sakur7a']];
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title === blog.description ? blog.title : `${title} | ${blog.title}`}</title>
    <meta name="description" content={summary} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={summary} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content={date ? 'article' : 'website'} />
    {image && <meta property="og:image" content={new URL(image, blog.site).href} />}
    {date && <meta property="article:published_time" content={new Date(date).toISOString()} />}
    <link rel="alternate" type="application/atom+xml" title="Sakura" href="/Blog/feed.xml" />
    <script is:inline src="/assets/js/theme.js"></script>
    <link rel="stylesheet" href="/assets/css/jinkai.css" />
    <link rel="stylesheet" href="/Blog/assets/css/style.css" />
  </head>
  <body id={bodyId}>
    <div class="header-menu" id="J_header">
      <ul class="header-item-container">
        <li class:list={['header-item-title', { active: homeActive }]}><a href="/Blog/" class="title">Sakura</a></li>
        {menu.map(([label, href]) => <li class:list={['header-item-left', { active: Astro.url.pathname === href }]}><a href={href} target={href.startsWith('http') ? '_blank' : undefined} rel={href.startsWith('http') ? 'noopener noreferrer' : undefined}>{label}</a></li>)}
        <li class="header-item search-btn-container"><button id="search-btn" class="search-btn" data-search-url="/Blog/search.json" aria-label="搜索文章" title="搜索文章 (Press /)"><svg width="18" height="18" viewBox="0 0 24 24" fill="none"><circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="2" /><path d="M20 20L16 16" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg></button></li>
        <li class="header-item theme-toggle-container"><button id="J_theme_toggle" class="theme-toggle-btn" aria-label="切换深色模式" title="切换深色模式"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" id="J_theme_icon"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg></button></li>
      </ul>
    </div>
    <div class:list={['entry-header', { 'has-image': image }]} style={image ? `background-image: url('${image}'); background-position: ${position};` : undefined}><p class="header-title">{title}</p><canvas id="J_firework_canvas" aria-hidden="true"></canvas></div>
    <main id="main" role="main"><slot /></main>
    <div class="search-panel" id="J_search_panel" hidden><div class="search-dialog" role="dialog" aria-modal="true" aria-label="搜索文章"><div class="search-box"><input id="J_search_input" type="search" placeholder="搜索标题或摘要" autocomplete="off" /><button type="button" id="J_search_close" aria-label="关闭搜索">Close</button></div><div class="search-results" id="J_search_results"></div></div></div>
    <footer class="site-footer"><p>© {new Date().getFullYear()} Sakura. Something for nothing.</p></footer>
    <script is:inline src="/Blog/assets/js/site.js"></script>
  </body>
</html>
