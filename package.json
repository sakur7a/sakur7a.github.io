{
  "name": "sakur7a-site",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/check-build-output.js",
    "preview": "astro preview",
    "test:unit": "node --test tests/*.test.js",
    "test:e2e": "playwright test",
    "test": "npm run test:unit && npm run build && npm run test:e2e",
    "post:publish": "node scripts/obsidian-publish.js --draft",
    "plugin:sync": "node scripts/sync-obsidian-plugin.js"
  },
  "devDependencies": {
    "@astrojs/markdown-remark": "^7.3.2",
    "@playwright/test": "^1.59.1",
    "astro": "7.3.6",
    "rehype-raw": "^7.0.0",
    "remark-math": "^6.0.0",
    "sharp": "^0.35.5",
    "yaml": "^2.9.1"
  },
  "overrides": {
    "katex": "^0.18.2"
  }
}
